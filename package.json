{
  "name": "@delta/ui",
  "private": false,
  "version": "0.1.1",
  "type": "module",
  "description": "Shared Delta UI and host/Plugin UI contracts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx tests/run.ts && npm run test:host",
    "test:i18n": "node scripts/check-i18n.cjs && node scripts/check-locales.cjs",
    "test:host": "tsx --test tests/host-channel.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.14",
    "@fontsource/ibm-plex-sans": "^5.0.21",
    "@noble/curves": "^1.8.2",
    "@noble/hashes": "^1.7.2",
    "@scure/base": "^1.2.4",
    "@scure/bip39": "^1.5.4",
    "d3-hierarchy": "^3.1.2",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "1.4.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.4"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/main.tsx",
    "./bootstrap": "./src/main.tsx",
    "./host": "./src/host/contract.ts",
    "./sdk": "./src/sdk/channel.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "public",
    "dist",
    "tests",
    "scripts",
    "tsconfig.json",
    "vite.config.ts",
    "index.html",
    "LICENSE",
    "NOTICE",
    "ui-package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/n-ycta/delta-ui.git"
  }
}
