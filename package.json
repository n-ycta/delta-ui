{
  "name": "@delta/ui",
  "private": false,
  "version": "0.3.2",
  "type": "module",
  "description": "Shared Delta UI and host/Plugin UI contracts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx tests/run.ts && npm run test:host && npm run test:workbench",
    "test:i18n": "node scripts/check-i18n.cjs && node scripts/check-locales.cjs",
    "test:host": "tsx --test tests/host-channel.test.ts tests/native-projection.test.ts tests/native-navigation.test.ts tests/compatibility.test.ts tests/auth-errors.test.ts tests/vector-grants.test.ts",
    "test:navigation": "node tests/native-navigation.browser.mjs",
    "test:onboarding": "node tests/native-onboarding.browser.mjs",
    "test:language": "node tests/language-settings.browser.mjs",
    "test:apps": "node --test tests/app-runtime.test.mjs",
    "test:embedding": "node scripts/prepare-test-app.mjs && node tests/app-embedding.browser.mjs",
    "test:profile": "node tests/profile-seed.browser.mjs",
    "test:workbench": "tsx --test tests/workbench.test.ts tests/surfaces.test.ts tests/catalog-intents.test.ts tests/surface-dashboards.test.ts",
    "test:mobile": "node tests/mobile-catalog.browser.mjs",
    "test:reliability": "node tests/reliability.browser.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.0.14",
    "@fontsource/ibm-plex-sans": "^5.0.21",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@noble/curves": "^1.8.2",
    "@noble/hashes": "^1.7.2",
    "@phosphor-icons/react": "^2.1.10",
    "@scure/base": "^1.2.4",
    "@scure/bip39": "^1.5.4",
    "@types/qrcode": "^1.5.6",
    "d3-hierarchy": "^3.1.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "1.4.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5",
    "@phosphor-icons/core": "^2.1.1"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.4"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/main.tsx",
    "./bootstrap": "./src/main.tsx",
    "./host": "./src/host/contract.ts",
    "./sdk": "./src/sdk/channel.ts",
    "./package.json": "./package.json",
    "./sdk/client": "./src/sdk/client.ts",
    "./sdk/surfaces": "./src/sdk/surfaces.ts",
    "./sdk/styles.css": "./src/sdk/styles.css",
    "./sdk/controls": "./src/sdk/controls.ts",
    "./sdk/icons": "./src/sdk/icons.ts"
  },
  "files": [
    "src",
    "public",
    "dist",
    "tests",
    "scripts",
    "tsconfig.json",
    "vite.config.ts",
    "index.html",
    "LICENSE",
    "NOTICE",
    "ui-package.json",
    "app-catalog.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/n-ycta/delta-ui.git"
  }
}
